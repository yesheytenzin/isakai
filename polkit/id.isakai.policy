<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Isakai</vendor>
  <vendor_url>https://github.com/yesheytenzin/isakai</vendor_url>

  <!-- M6f: split actions, one per privileged operation, each pinned to a
       dedicated wrapper in /usr/bin (isakai-allocate-uid etc., installed
       by `make install`). Distinct authentication messages per operation;
       the dialog no longer interpolates the raw command line
       ($(command_line) is documented as not-for-display and leaks
       absolute paths). The helper itself still re-validates package,
       UID range, anchored data dir, and (for run) the java allowlist on
       every invocation — the policy only shapes the dialog and the
       auth target.
       Install note: exec.path below MUST be the installed wrapper paths;
       a mismatched path silently denies authorization. -->
  <action id="id.isakai.allocate-uid">
    <description>Install an app in its own isolated account</description>
    <message>Authentication is required to install an app with its own isolated Linux account</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/isakai-allocate-uid</annotate>
  </action>

  <action id="id.isakai.remove-uid">
    <description>Remove an app and its isolated account</description>
    <message>Authentication is required to remove an app and its isolated Linux account</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/isakai-remove-uid</annotate>
  </action>

  <action id="id.isakai.run-app">
    <description>Launch an app under its isolated account</description>
    <message>Authentication is required to launch the app in its sandbox</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/isakai-run-app</annotate>
  </action>
</policyconfig>
